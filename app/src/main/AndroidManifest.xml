<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:supportsRtl="true">

        <receiver
            android:name=".DateWidget"
            android:label="日期"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
                <action android:name="android.intent.action.TIME_SET"/>
                <action android:name="com.example.datewidget.MIDNIGHT_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info"/>
            <meta-data android:name="com.vivo.widget.show.title" android:value="1"/>
            <meta-data android:name="com.vivo.widget_ui_version" android:value="2.0"/>
            <meta-data android:name="com.vivo.launcher.widget.adapter_feature" android:value="1"/>
            <meta-data android:name="vivo_widget" android:value="true"/>
            <meta-data android:name="vivo_update_period" android:value="60000"/>
        </receiver>

    </application>

</manifest>
